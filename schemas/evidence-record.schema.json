{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-ios.local/schemas/evidence-record/1.0.0",
  "title": "Aegis IOS Evidence Record",
  "description": "I0 canonical template for SPEC-008 §3 validation evidence. A record is evidence of execution only after its stated result and review fields are completed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "testId",
    "version",
    "owner",
    "requirements",
    "subject",
    "environment",
    "dataSet",
    "executor",
    "startedAt",
    "endedAt",
    "expectedResult",
    "actualResult",
    "evidence",
    "disposition",
    "reviewer"
  ],
  "properties": {
    "testId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "commitOrBuild"],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "commitOrBuild": { "type": "string", "minLength": 1 }
      }
    },
    "environment": { "type": "string", "minLength": 1 },
    "dataSet": { "type": "string", "minLength": 1 },
    "executor": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "expectedResult": { "type": "string", "minLength": 1 },
    "actualResult": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "disposition": { "enum": ["Passed", "Failed", "Blocked", "Waived"] },
    "defects": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewer": { "type": "string", "minLength": 1 }
  }
}
